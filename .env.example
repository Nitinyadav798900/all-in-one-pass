# ── Required ─────────────────────────────────────────────────────────────
# Master API key for admin endpoints (/admin/*, /sites/*/reload)
MASTER_API_KEY=mnbvcxz9876543210

# ── Optional: Upstash Redis (free tier at upstash.com) ───────────────────
# Without this, cache runs in-memory (resets on redeploy)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Optional: Port (default 3000) ────────────────────────────────────────
PORT=3000
